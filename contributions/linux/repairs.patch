From d81259d8a87c9b4e3ddcb3b022315eb37a9332da Mon Sep 17 00:00:00 2001
From: Steve-Strange <120027032+Steve-Strange@users.noreply.github.com>
Date: Fri, 16 Oct 2026 19:12:08 +0800
Subject: [PATCH 1/4] fix(linux): preserve running backend executables across
 upgrades

Keep the previous installation while /proc identifies processes executing from it, so surviving cmux-tui daemons can spawn terminal hosts. Cover the updater and user installer with live-executable regressions.
---
 .../browser/cmux_term/cmux_update_script.cc   | 17 +++++++--
 .../cmux_term/cmux_update_script_test.cc      | 37 +++++++++++++++++++
 scripts/build-linux-user-installer.sh         | 11 +++++-
 scripts/test-linux-user-installer.sh          | 30 ++++++++++++++-
 4 files changed, 89 insertions(+), 6 deletions(-)

diff --git a/overlay/chrome/browser/cmux_term/cmux_update_script.cc b/overlay/chrome/browser/cmux_term/cmux_update_script.cc
index 8c0b031..abcbc41 100644
--- a/overlay/chrome/browser/cmux_term/cmux_update_script.cc
+++ b/overlay/chrome/browser/cmux_term/cmux_update_script.cc
@@ -34,6 +34,19 @@ try {
   const char* relaunch = platform == UpdateInstallPlatform::kMac
                              ? "open \"$current\""
                              : "nohup \"$current/$relaunch\" >/dev/null 2>&1 &";
+  const char* cleanup = platform == UpdateInstallPlatform::kLinux
+      ? R"SHELL(  # The browser can exit while its PTY daemon and hosts stay alive.
+  # current_exe() in that daemon must remain executable for new terminals.
+  in_use=0
+  for executable in /proc/[0-9]*/exe; do
+    target=$(readlink "$executable" 2>/dev/null) || continue
+    case "$target" in "$backup"/*) in_use=1; break ;; esac
+  done
+  if [ "$in_use" -eq 0 ]; then
+    rm -rf -- "$backup"
+  fi
+)SHELL"
+      : "  rm -rf -- \"$backup\"\n";
   return std::string(R"SHELL(#!/bin/sh
 set -eu
 parent_pid="$1"
@@ -48,9 +61,7 @@ done
 backup="${current}.cmux-old.$$"
 mv -- "$current" "$backup"
 if mv -- "$staged" "$current"; then
-  )SHELL") + relaunch + R"SHELL(
-  rm -rf -- "$backup"
-else
+  )SHELL") + relaunch + "\n" + cleanup + R"SHELL(else
   mv -- "$backup" "$current"
   exit 1
 fi
diff --git a/overlay/chrome/browser/cmux_term/cmux_update_script_test.cc b/overlay/chrome/browser/cmux_term/cmux_update_script_test.cc
index 220ed96..5acab17 100644
--- a/overlay/chrome/browser/cmux_term/cmux_update_script_test.cc
+++ b/overlay/chrome/browser/cmux_term/cmux_update_script_test.cc
@@ -12,7 +12,9 @@
 #include <thread>
 
 #if !defined(_WIN32)
+#include <signal.h>
 #include <sys/stat.h>
+#include <sys/wait.h>
 #include <unistd.h>
 #endif
 
@@ -99,6 +101,41 @@ int main() {
     }
   }
   Check(!backup_remains, "POSIX installer removed its rollback copy");
+#if defined(__linux__)
+  // Reproduce a persistent PTY daemon surviving the browser update. Its old
+  // executable path must still work when it spawns another terminal host.
+  std::filesystem::create_directories(staged);
+  std::filesystem::copy_file("/bin/sleep", current / "cmux-tui");
+  std::filesystem::copy_file(current / "cmux-browser",
+                             staged / "cmux-browser");
+  const pid_t daemon = fork();
+  Check(daemon >= 0, "started a persistent backend fixture");
+  if (daemon == 0) {
+    execl((current / "cmux-tui").c_str(), "cmux-tui", "30", nullptr);
+    _exit(127);
+  }
+  const auto proc_exe = std::filesystem::path("/proc") /
+                        std::to_string(daemon) / "exe";
+  bool started = false;
+  for (int attempt = 0; attempt < 100; ++attempt) {
+    std::error_code error;
+    if (std::filesystem::read_symlink(proc_exe, error) == current / "cmux-tui") {
+      started = true;
+      break;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  Check(started, "backend fixture runs from the old install");
+  Check(std::system(command.c_str()) == 0,
+        "update completed with an active backend");
+  const auto retained_exe = std::filesystem::read_symlink(proc_exe);
+  Check(std::filesystem::exists(retained_exe),
+        "active backend executable retained after update");
+  Check(std::system(("'" + retained_exe.string() + "' 0").c_str()) == 0,
+        "old backend can still spawn a host from its executable path");
+  kill(daemon, SIGTERM);
+  waitpid(daemon, nullptr, 0);
+#endif
   std::filesystem::remove_all(test_root);
 #endif
 
